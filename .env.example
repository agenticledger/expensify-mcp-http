PORT=3100

# Direct mode: clients send their own credentials on EVERY /mcp POST, GET, DELETE:
# Authorization: Bearer partnerUserID:partnerUserSecret
# Also supported: Bearer {"partnerUserID":"...","partnerUserSecret":"..."}
# The service stores no provider credential in environment variables.

# Optional broker mode. All four values below are required for broker readiness.
# Obtain install identity through the existing broker provisioning procedure.
BROKER_BASE_URL=https://connectionsbroker.agenticledger.ai
BROKER_INSTALL_BEARER=
BROKER_JWT_KEY=
BROKER_CLIENT_NAMESPACE=
BROKER_PRINCIPAL_HMAC_KEY=
BROKER_PRINCIPAL_HEADER=x-broker-principal
# No anonymous/default principal. BROKER_FALLBACK_PRINCIPAL is no longer used.
